# Local dev uses SQLite automatically. No account is pre-created.
APP_URL=http://127.0.0.1:5173
# Production: PostgreSQL connection string (pooled URL recommended).
DATABASE_URL=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use common for personal + work/school Microsoft accounts.
MICROSOFT_TENANT_ID=common
